{
  "name": "riftinfos",
  "version": "1.0.0",
  "description": "Aplicativo web para consultar personagens do RiftStream, analisar forjas e equipamentos, simular builds, comparar jogadores e acompanhar lives.",
  "main": "analise.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/review-regression.test.cjs && node tests/calculos-independentes.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "atualizar:sprites": "node scripts/atualizar_sprites.mjs",
    "atualizar:sprites:validar": "node scripts/atualizar_sprites.mjs --validar",
    "verificar:patch": "node scripts/verificar_patch.mjs",
    "calibrar:curvas": "node scripts/calibrar_curvas.mjs",
    "auditar:monstros": "node scripts/auditar_monstros.mjs",
    "verificar:release": "node scripts/verificar_release.mjs",
    "otimizar:build": "node scripts/otimizar_build.mjs",
    "diagnostico": "node scripts/rodar_diagnostico.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nandosts/riftinfos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nandosts/riftinfos/issues"
  },
  "homepage": "https://github.com/Nandosts/riftinfos#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
